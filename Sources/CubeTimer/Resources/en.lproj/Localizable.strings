"help.title" = "Pomodoro Float Help";
"help.subtitle" = "A quick reference for timer controls and shortcuts.";
"help.topic.Start and control a timer" = "Start and control a timer";
"help.detail.Start and control a timer" = "Click the timer to start, pause, or resume. Press Space for the same action and Command-R to reset. Choose a preset and press Start; Command-1 through Command-6 start saved presets immediately.";
"help.topic.Use the cube" = "Use the cube";
"help.detail.Use the cube" = "Drag to rotate the cube. Click a face to start that preset. Press Command-Left Arrow or Command-Right Arrow to turn a face. Right-click the cube for timer and window controls.";
"help.topic.Use the floating window" = "Use the floating window";
"help.detail.Use the floating window" = "Press Command-Shift-B to switch window styles. In the borderless window, Control-drag the cube to move it and Control-drag the lower-right grip to resize it. The right-click menu contains timer controls.";
"help.topic.Choose a display" = "Choose a display";
"help.detail.Choose a display" = "Use the display picker to choose Cube, Digital, or Clock. All three displays support full screen. Cube becomes an immersive interactive view; press Escape to leave it.";
"help.topic.Countdown and stopwatch" = "Countdown and stopwatch";
"help.detail.Countdown and stopwatch" = "Choose Countdown to enter a one-off duration, or Stopwatch to count up. Command-R resets either mode. A one-off timer suspends an active Pomodoro; choose Resume Pomodoro or press Command-Shift-P to return to it.";
"help.topic.Customize the timer" = "Customize the timer";
"help.detail.Customize the timer" = "Press Command-Comma to edit preset names, durations, and Pomodoro settings, and to change appearance, sound, and window options. Enable the menu bar timer from Settings > Window.";
