"welcome.title" = "Welcome to Pomodoro Float";
"welcome.subtitle" = "A quick guide to your timer and focus tools.";
"welcome.section.Displays" = "Displays";
"welcome.detail.Displays" = "Cube, Digital, and Desk Clock each show your time differently.";
"welcome.section.Presets and Pomodoro" = "Presets and Pomodoro";
"welcome.detail.Presets and Pomodoro" = "Edit preset names and roles in Settings. Focus and Short Break roles guide Pomodoro phases.";
"welcome.section.Countdown and Stopwatch" = "Countdown and Stopwatch";
"welcome.detail.Countdown and Stopwatch" = "Countdown starts a one-off duration. Stopwatch counts elapsed time. Either can suspend a Pomodoro you can resume later.";
"welcome.section.Sounds and shortcuts" = "Sounds and shortcuts";
"welcome.detail.Sounds and shortcuts" = "Cube preset tiles play the preset sound. Use Command-Shift-1/2/3 to choose Cube, Digital, or Clock; Command-1 through Command-6 start presets.";
"welcome.section.Floating window" = "Floating window";
"welcome.detail.Floating window" = "Use Command-Shift-B to switch window styles. Control-drag the floating window to move it, and right-click for controls.";
